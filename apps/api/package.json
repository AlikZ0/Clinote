{
  "name": "@clinote/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/cli.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@clinote/config": "workspace:*",
    "@clinote/shared": "workspace:*",
    "@clinote/types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12"
  }
}
