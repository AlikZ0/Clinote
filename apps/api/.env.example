NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of web origins allowed to call this API with credentials.
WEB_ORIGIN=http://localhost:3000

# memory: development only, everything is lost on restart.
# postgres: the real thing; requires DATABASE_URL.
STORAGE_DRIVER=postgres
DATABASE_URL=postgres://clinote:clinote@127.0.0.1:5433/clinote
DATABASE_MAX_CONNECTIONS=10
# Migrations run on boot outside production. In production they are a deploy
# step that must finish before the new version serves traffic.
# DATABASE_MIGRATE_ON_BOOT=false

# Object storage for encrypted backups.
# memory: development only, nothing is durable.
OBJECT_STORE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=clinote-backups
S3_ACCESS_KEY_ID=clinote
S3_SECRET_ACCESS_KEY=clinote-secret
S3_FORCE_PATH_STYLE=true

# Notifications.
# memory: development only, nothing is sent.
EMAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1125
EMAIL_FROM=Clinote <no-reply@clinote.app>

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Push is simply unavailable while these are unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@clinote.app

# Required in production, at least 32 characters. Generated per boot otherwise.
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Set to false only for local HTTP development.
# COOKIE_SECURE=true
